# backtide: the black box around the AI agent. Written by the installer from
# deploy/systemd/backtide.service.in (backtide/setup/units.py); change the template, not this.
# Root with a short capability list (docs/25, section 2, option A, as measured in T13-1).
[Unit]
Description=backtide, black box for an AI agent
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=@VOLUME_MOUNT@ @PROXY_CHANNEL_DIR@
AssertPathIsMountPoint=@VOLUME_MOUNT@
AssertPathIsMountPoint=@PROXY_CHANNEL_DIR@

[Service]
Type=simple
# --grupo-web: the web's narrow socket (<state dir>/web.sock, 0660, this group only; T12c).
ExecStart=@PROGRAM@ vigilar --config @CONFIG_FILE@ --grupo-web @WEB_USER@
Restart=always
RestartSec=5
TimeoutStopSec=120
KillMode=mixed
UMask=0077
CapabilityBoundingSet=@CAPABILITIES@
NoNewPrivileges=yes
ProtectSystem=strict
# The owner's exported copies (`backtide exportar`): the one more folder it may write, and
# where it is told to write them (code review of 2026-10-29, S1). The other agents' volumes are
# under @AGENT_VOLUMES@ (T26-2b): it is there as soon as the first one is, and a restart sees it.
ReadWritePaths=@STATE_DIR@ @VOLUME_MOUNT@ -@AGENT_VOLUMES@ -@EXPORT_DIR@
Environment=@EXPORT_DIR_ENV@=@EXPORT_DIR@
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Measured in clean VMs in T13-3: these coexist with snapshots, rewinds, the watcher and Docker
# (exposure 3.4 on systemd 259, 3.1 before the service could read the clock).
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# adjtimex only to read whether the clock is synchronised, before pruning snapshots by age. Setting
# the time needs CAP_SYS_TIME, which this unit does not have; ProtectClock would refuse the read too.
SystemCallFilter=@system-service adjtimex clock_adjtime
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
